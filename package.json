{
  "name": "archtree",
  "version": "1.0.0",
  "description": "",
  "main": "src/app.ts",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc --noEmit",
    "build:web": "npm run build --workspace @archtree/finitude-web",
    "test": "npm run test:server && npm run test:web",
    "test:server": "tsx --test test/**/*.test.ts",
    "test:web": "npm run test --workspace @archtree/finitude-web",
    "test:e2e": "npm run test:e2e --workspace @archtree/finitude-web",
    "test:e2e:chromium": "npm run test:e2e:chromium --workspace @archtree/finitude-web",
    "test:integration": "tsx --test --test-concurrency=1 test/**/*.integration.ts",
    "test:media-load": "node scripts/media-range-load.mjs",
    "stage:eb-artifact": "node scripts/stage-eb-artifact.mjs",
    "start": "NODE_ENV=production tsx src/app.ts",
    "dev": "NODE_ENV=develop tsx src/app.ts",
    "dev:web": "npm run dev --workspace @archtree/finitude-web",
    "dev:auth-rotation": "NODE_ENV=develop ACCESS_TOKEN_SECONDS=5 tsx src/app.ts"
  },
  "author": "Yangyin Xu",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/client-sesv2": "^3.1097.0",
    "@simplewebauthn/server": "^13.3.2",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.0",
    "dotenv": "^16.0.3",
    "express": "^4.19.2",
    "express-validator": "^6.14.0",
    "google-auth-library": "^10.9.1",
    "jose": "^6.2.4",
    "jsonwebtoken": "^8.5.1",
    "mongodb": "^4.16.0",
    "multer": "^2.2.0",
    "music-metadata": "^11.14.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/multer": "^2.2.0",
    "nodemon": "^2.0.16",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "24.x"
  }
}
