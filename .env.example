# Database
DB_CONN_STRING="mongodb+srv://<username>:<password>@<cluster-url>/<optional-db-params>"
DB_NAME="archtree"
DB_CONNECT_TIMEOUT_MS="10000"
DB_SERVER_SELECTION_TIMEOUT_MS="10000"
DB_SOCKET_TIMEOUT_MS="120000"
DB_WAIT_QUEUE_TIMEOUT_MS="10000"
DB_MAX_POOL_SIZE="100"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
# Optional; JWT_SECRET is used as the code pepper when this is omitted.
AUTH_CODE_PEPPER="replace-with-a-separate-long-random-secret"
# Verified SES sender required for registration verification and password recovery.
AUTH_EMAIL_FROM="auth@example.com"
APPLE_CLIENT_IDS="com.yxu.Finitude-iOS"
GOOGLE_CLIENT_IDS="replace-with-google-server-client-id.apps.googleusercontent.com"
WEBAUTHN_RP_ID="auth.example.com"
WEBAUTHN_ORIGIN="https://auth.example.com"
WEBAUTHN_RP_NAME="Finitude"
# Optional comma-separated additional exact origins for cookie-authenticated browser mutations.
BROWSER_ALLOWED_ORIGINS="https://auth.example.com"

# AWS S3
AWS_ACCESS_KEY_ID="replace-with-access-key-id"
AWS_SECRET_ACCESS_KEY="replace-with-secret-access-key"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="replace-with-s3-bucket-name"
S3_CONNECTION_TIMEOUT_MS="5000"
S3_REQUEST_TIMEOUT_MS="60000"
S3_MAX_ATTEMPTS="2"
S3_SUMMARY_WAIT_TIMEOUT_MS="2000"

# App runtime
PORT="8080"
MAX_AUDIO_UPLOAD_MB="512"
MAX_AUDIO_BATCH_UPLOAD_MB="1024"
MAX_AUDIO_BATCH_FILES="5"
MAX_IMAGE_UPLOAD_MB="10"
MAX_RECONCILIATION_OBJECTS="50000"
MAX_STORAGE_SUMMARY_OBJECTS="1000000"
MAX_VIDEO_STREAM_CHUNK_MB="4"
MAX_MEDIA_REQUESTS_PER_IP="8"
MAX_MEDIA_REQUESTS_GLOBAL="40"
SERVER_HEADERS_TIMEOUT_MS="60000"
SERVER_REQUEST_TIMEOUT_MS="900000"
SERVER_KEEP_ALIVE_TIMEOUT_MS="5000"
SERVER_INACTIVITY_TIMEOUT_MS="120000"
SERVER_MAX_REQUESTS_PER_SOCKET="1000"
SERVER_MAX_CONNECTIONS="1000"
# Single-instance Nginx is the only trusted hop before the Node service.
TRUST_PROXY_HOPS="1"
