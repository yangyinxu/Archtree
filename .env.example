# Database
DB_CONN_STRING="mongodb+srv://<username>:<password>@<cluster-url>/<optional-db-params>"
DB_NAME="archtreeDb"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"

# AWS S3
AWS_ACCESS_KEY_ID="replace-with-access-key-id"
AWS_SECRET_ACCESS_KEY="replace-with-secret-access-key"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="replace-with-s3-bucket-name"

# App runtime
PORT="8080"

# Legacy/optional variables
GAMES_COLLECTION_NAME=""
