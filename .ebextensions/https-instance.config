Resources:
  # Single-instance environments receive traffic directly on the instance
  # security group, so TLS must be admitted here rather than on a load balancer.
  ArchtreeHttpsIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId:
        Fn::GetAtt:
          - AWSEBSecurityGroup
          - GroupId
      IpProtocol: tcp
      FromPort: 443
      ToPort: 443
      CidrIp: 0.0.0.0/0
