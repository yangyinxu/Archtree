# Points room audio analysis at the FFmpeg that
# .platform/hooks/prebuild/02_install_ffmpeg.sh installs, so the decoder never
# depends on the application service's PATH. A value set directly on the
# environment still takes precedence over this default.
option_settings:
  aws:elasticbeanstalk:application:environment:
    ROOM_AUDIO_FFMPEG_PATH: /usr/local/bin/ffmpeg
