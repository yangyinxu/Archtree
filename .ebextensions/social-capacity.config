# Conservative room and realtime capacity for the single t4g.micro with a
# free-tier MongoDB Atlas cluster, which throttles above 100 operations per
# second. One playing two-member room plus ten realtime sockets stays near 65
# operations per second, leaving the rest for catalog, auth and listening; see
# docs/testing/t4g-micro-capacity-screen.md for the measured budget. These only
# apply while FINITUDE_SOCIAL_ENABLED and FINITUDE_ROOMS_ENABLED are true. A
# value set directly on the environment takes precedence over these defaults.
option_settings:
  aws:elasticbeanstalk:application:environment:
    FINITUDE_ROOMS_MAX_OPEN: "1"
    FINITUDE_ROOM_MAX_MEMBERS: "2"
    FINITUDE_REALTIME_MAX_SOCKETS: "10"
